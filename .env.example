DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# PostgreSQL environment variables
POSTGRES_DB=ai_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here 
