# Django settings
DEBUG=1
SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Database settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_chatbot
